# Local frontend origins allowed to call the API.
AERIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional protection for expensive POST build endpoints.
# Leave blank for local development. In deployment, keep this server-side
# and inject the matching X-AERIS-Build-Token header at the trusted proxy/API client.
AERIS_BUILD_TOKEN=
