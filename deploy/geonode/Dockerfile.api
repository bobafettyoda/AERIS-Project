FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    OMP_NUM_THREADS=2 \
    OPENBLAS_NUM_THREADS=2 \
    NUMEXPR_NUM_THREADS=2 \
    GDAL_CACHEMAX=256

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libexpat1 \
        libgomp1 \
        tini \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 aeris \
    && useradd \
        --uid 10001 \
        --gid 10001 \
        --create-home \
        --shell /usr/sbin/nologin \
        aeris

WORKDIR /opt/aeris/AERIS/backend

COPY AERIS/backend/requirements.txt /tmp/aeris-requirements.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /tmp/aeris-requirements.txt

RUN python -c "import xml.parsers.expat; import geopandas; import numpy; import pandas; import pyogrio; import pyproj; import rasterio; import shapely; print('AERIS geospatial runtime imports: PASS')"

COPY --chown=aeris:aeris AERIS /opt/aeris/AERIS

RUN mkdir -p /opt/aeris/AERIS/data \
    && chown -R aeris:aeris /opt/aeris

USER aeris

EXPOSE 8000

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--root-path", "/aeris-api", "--proxy-headers", "--forwarded-allow-ips", "*"]
